nowrap; line-height: 1.5; max-width: 200px; text-align: center;\"><span class=\"edgeLabel\"></span></div></foreignObject></g></g><g class=\"edgeLabel\"><g class=\"label\" data-id=\"L_C_D_0\" transform=\"translate(0, 0)\"><foreignObject width=\"0\" height=\"0\"><div xmlns=\"http://www.w3.org/1999/xhtml\" class=\"labelBkg\" style=\"display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;\"><span class=\"edgeLabel\"></span></div></foreignObject></g></g></g><g class=\"nodes\"><g class=\"node default\" id=\"flowchart-A-0\" transform=\"translate(133.91015625, 82)\"><rect class=\"basic label-container\" style=\"fill:#ffebee !important\" x=\"-88.41015625\" y=\"-27\" width=\"176.8203125\" height=\"54\"></rect><g class=\"label\" style=\"\" transform=\"translate(-58.41015625, -12)\"><rect></rect><foreignObject width=\"116.8203125\" height=\"24\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;\"><span class=\"nodeLabel\"><p>❌ 初面就问薪资</p></span></div></foreignObject></g></g><g class=\"node default\" id=\"flowchart-B-1\" transform=\"translate(398.91796875, 82)\"><rect class=\"basic label-container\" style=\"fill:#fff3e0 !important\" x=\"-101.59765625\" y=\"-27\" width=\"203.1953125\" height=\"54\"></rect><g class=\"label\" style=\"\" transform=\"translate(-71.59765625, -12)\"><rect></rect><foreignObject width=\"143.1953125\" height=\"24\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;\"><span class=\"nodeLabel\"><p>⏳ 等拿到口头 Offer</p></span></div></foreignObject></g></g><g class=\"node default\" id=\"flowchart-C-3\" transform=\"translate(669.11328125, 82)\"><rect class=\"basic label-container\" style=\"fill:#e8f5e9 !important\" x=\"-93.59765625\" y=\"-39\" width=\"187.1953125\" height=\"78\"></rect><g class=\"label\" style=\"\" transform=\"translate(-63.59765625, -24)\"><rect></rect><foreignObject width=\"127.1953125\" height=\"48\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;\"><span class=\"nodeLabel\"><p>✅ 最佳时机:<br>收到正式 Offer 后</p></span></div></foreignObject></g></g><g class=\"node default\" id=\"flowchart-D-5\" transform=\"translate(923.30859375, 82)\"><rect class=\"basic label-container\" style=\"fill:#c8e6c9 !important\" x=\"-85.59765625\" y=\"-39\" width=\"171.1953125\" height=\"78\"></rect><g class=\"label\" style=\"\" transform=\"translate(-55.59765625, -24)\"><rect></rect><foreignObject width=\"111.1953125\" height=\"48\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;\"><span class=\"nodeLabel\"><p>💡 有多个 Offer<br>互相比较时</p></span></div></foreignObject></g></g></g></g></g></g></g></svg></div>\n<table>\n<thead>\n<tr>\n<th>时机</th>\n<th>策略</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>HR 初筛问期望</strong></td>\n<td>给一个范围，不要具体数字</td>\n</tr>\n<tr>\n<td><strong>面试中问期望</strong></td>\n<td>说\"根据岗位和团队匹配度来谈\"</td>\n</tr>\n<tr>\n<td><strong>拿到 Offer 后</strong></td>\n<td>正式开始谈判</td>\n</tr>\n<tr>\n<td><strong>有多个 Offer</strong></td>\n<td>用这个作为谈判筹码</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 data-heading=\"四、谈判话术模板\" dir=\"auto\">四、谈判话术模板</h2>\n<h3 data-heading=\"场景 1：HR 问期望薪资\" dir=\"auto\">场景 1：HR 问期望薪资</h3>\n<blockquote dir=\"auto\">\n<p>\"我对贵公司的岗位非常感兴趣。薪资方面，我相信公司会给出与岗位价值和我的能力相匹配的薪酬。我更看重团队的发展空间和技术挑战。如果您需要参考，我了解市场上类似岗位的范围大概在 [X-Y] 万。具体的我们可以后续详细沟通。\"</p>\n</blockquote>\n<h3 data-heading=\"场景 2：收到 Offer 后觉得偏低\" dir=\"auto\">场景 2：收到 Offer 后觉得偏低</h3>\n<blockquote dir=\"auto\">\n<p>\"感谢贵公司的 Offer，我对加入团队非常期待。关于薪资，我有几点想沟通：</p>\n<ol>\n<li dir=\"auto\">我在 [某方面] 有 [X] 年的经验，曾主导 [项目]，带来了 [成果]</li>\n<li dir=\"auto\">我了解市场上类似背景的候选人薪资在 [X-Y] 范围</li>\n<li dir=\"auto\">考虑到我在 [某技能] 方面的专长，能否将 base 调整到 [目标数字]？</li>\n</ol>\n<p>当然，我也理解公司的薪酬体系，如果 base 调整空间有限，<br>\n我们也可以探讨签字费或股票方面的补充。\"</p>\n</blockquote>\n<h3 data-heading=\"场景 3：用其他 Offer 谈判\" dir=\"auto\">场景 3：用其他 Offer 谈判</h3>\n<blockquote dir=\"auto\">\n<p>\"我很珍惜贵公司的机会。目前我手上有另一个 Offer，<br>\n总包大概 [X] 万。但我更倾向于贵公司，因为 [原因]。<br>\n不知道贵公司的 Offer 是否还有调整的空间？\"</p>\n</blockquote>\n<hr>\n<h2 data-heading=\"五、谈判要素\" dir=\"auto\">五、谈判要素</h2>\n<h3 data-heading=\"总包构成\" dir=\"auto\">总包构成</h3>\n<pre class=\"language-markdown\" style=\"overflow-x: hidden !important; padding: 6px 12px 8px !important;\"><code class=\"language-markdown is-loaded\" style=\"display: block !important; width: 100% !important; min-width: 0px !important; overflow-x: auto !important; white-space: pre !important; overflow-wrap: normal !important; max-width: 100% !important; box-sizing: border-box !important; padding: 4px 0px 2px !important;\"><span class=\"token title important\"><span class=\"token punctuation\">##</span> 薪资总包（Total Compensation）</span>\n\n<span class=\"token list punctuation\">1.</span> <span class=\"token bold\"><span class=\"token punctuation\">**</span><span class=\"token content\">Base（基本工资）</span><span class=\"token punctuation\">**</span></span>\n   <span class=\"token list punctuation\">-</span> 最稳定的部分\n   <span class=\"token list punctuation\">-</span> 社保、公积金、年终奖的计算基数\n   <span class=\"token list punctuation\">-</span> 尽量争取提高\n\n<span class=\"token list punctuation\">2.</span> <span class=\"token bold\"><span class=\"token punctuation\">**</span><span class=\"token content\">年终奖</span><span class=\"token punctuation\">**</span></span>\n   <span class=\"token list punctuation\">-</span> 通常为 3-6 个月\n   <span class=\"token list punctuation\">-</span> 问清楚发放条件（绩效挂钩？）\n\n<span class=\"token list punctuation\">3.</span> <span class=\"token bold\"><span class=\"token punctuation\">**</span><span class=\"token content\">签字费（Signing Bonus）</span><span class=\"token punctuation\">**</span></span>\n   <span class=\"token list punctuation\">-</span> 一次性发放\n   <span class=\"token list punctuation\">-</span> 谈判的重要筹码\n\n<span class=\"token list punctuation\">4.</span> <span class=\"token bold\"><span class=\"token punctuation\">**</span><span class=\"token content\">股票/期权（RSU/Option）</span><span class=\"token punctuation\">**</span></span>\n   <span class=\"token list punctuation\">-</span> 了解归属期（Vesting Schedule）\n   <span class=\"token list punctuation\">-</span> 4 年归属期是行业标准\n\n<span class=\"token list punctuation\">5.</span> <span class=\"token bold\"><span class=\"token punctuation\">**</span><span class=\"token content\">其他福利</span><span class=\"token punctuation\">**</span></span>\n   <span class=\"token list punctuation\">-</span> 搬家补贴\n   <span class=\"token list punctuation\">-</span> 教育补贴\n   <span class=\"token list punctuation\">-</span> 餐补/交通补\n</code><button class=\"copy-code-button\" aria-label=\"复制代码\" title=\"复制代码\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"svg-icon lucide-copy\"><rect x=\"8\" y=\"8\" width=\"14\" height=\"14\" rx=\"2\" ry=\"2\"></rect><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"></path></svg></button></pre>\n<hr>\n<h2 data-heading=\"六、注意事项\" dir=\"auto\">六、注意事项</h2>\n<h3 data-heading=\"✅ 应该做的\" dir=\"auto\">✅ 应该做的</h3>\n<ul>\n<li dir=\"auto\">事先做好市场调研</li>\n<li dir=\"auto\">准备好自己的价值论据</li>\n<li dir=\"auto\">保持礼貌和专业</li>\n<li dir=\"auto\">考虑总包而不仅是 base</li>\n<li dir=\"auto\">书面确认所有承诺</li>\n</ul>\n<h3 data-heading=\"❌ 不应该做的\" dir=\"auto\">❌ 不应该做的</h3>\n<ul>\n<li dir=\"auto\">撒谎有其他 Offer（可能被查）</li>\n<li dir=\"auto\">态度强硬或威胁</li>\n<li dir=\"auto\">只谈钱不谈发展</li>\n<li dir=\"auto\">接受口头承诺不书面确认</li>\n<li dir=\"auto\">频繁反悔已同意的条件</li>\n</ul>\n<hr>\n<h2 data-heading=\"七、相关知识点\" dir=\"auto\">七、相关知识点</h2>\n<ul>\n<li dir=\"auto\"><a data-href=\"%E5%A4%A7%E6%A8%A1%E5%9E%8B/%E5%A4%A7%E6%A8%A1%E5%9E%8B%E9%9D%A2%E8%AF%95/%E9%A2%98%E9%9B%86/03-%E9%9D%A2%E8%AF%95%E6%94%BB%E7%95%A5/%E9%AB%98%E9%A2%91%E5%8F%8D%E9%97%AE%E9%97%AE%E9%A2%98%E6%B8%85%E5%8D%95/\" href=\"/%E5%A4%A7%E6%A8%A1%E5%9E%8B/%E5%A4%A7%E6%A8%A1%E5%9E%8B%E9%9D%A2%E8%AF%95/%E9%A2%98%E9%9B%86/03-%E9%9D%A2%E8%AF%95%E6%94%BB%E7%95%A5/%E9%AB%98%E9%A2%91%E5%8F%8D%E9%97%AE%E9%97%AE%E9%A2%98%E6%B8%85%E5%8D%95/\" class=\"internal-link\" target=\"\" rel=\"noopener nofollow\">高频反问问题清单</a> — 了解公司薪酬体系</li>\n<li dir=\"auto\"><a data-href=\"%E5%A4%A7%E6%A8%A1%E5%9E%8B/%E5%A4%A7%E6%A8%A1%E5%9E%8B%E9%9D%A2%E8%AF%95/%E9%A2%98%E9%9B%86/03-%E9%9D%A2%E8%AF%95%E6%94%BB%E7%95%A5/%E9%9D%A2%E8%AF%95%E5%89%8DChecklist/\" href=\"/%E5%A4%A7%E6%A8%A1%E5%9E%8B/%E5%A4%A7%E6%A8%A1%E5%9E%8B%E9%9D%A2%E8%AF%95/%E9%A2%98%E9%9B%86/03-%E9%9D%A2%E8%AF%95%E6%94%BB%E7%95%A5/%E9%9D%A2%E8%AF%95%E5%89%8DChecklist/\" class=\"internal-link\" target=\"\" rel=\"noopener nofollow\">面试前Checklist</a> — 面试前准备</li>\n</ul>","headings":[]}