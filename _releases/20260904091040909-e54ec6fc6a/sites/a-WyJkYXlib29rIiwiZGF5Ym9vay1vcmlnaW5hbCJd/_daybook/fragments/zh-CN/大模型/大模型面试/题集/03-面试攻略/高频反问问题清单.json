\" markerUnits=\"userSpaceOnUse\" markerWidth=\"11\" markerHeight=\"11\" orient=\"auto\"><circle cx=\"5\" cy=\"5\" r=\"5\" class=\"arrowMarkerPath\" style=\"stroke-width: 1; stroke-dasharray: 1, 0;\"></circle></marker><marker id=\"mca24cb8765eabb1e-mca24cb8765eabb1e_flowchart-v2-crossEnd\" class=\"marker cross flowchart-v2\" viewBox=\"0 0 11 11\" refX=\"12\" refY=\"5.2\" markerUnits=\"userSpaceOnUse\" markerWidth=\"11\" markerHeight=\"11\" orient=\"auto\"><path d=\"M 1,1 l 9,9 M 10,1 l -9,9\" class=\"arrowMarkerPath\" style=\"stroke-width: 2; stroke-dasharray: 1, 0;\"></path></marker><marker id=\"mca24cb8765eabb1e-mca24cb8765eabb1e_flowchart-v2-crossStart\" class=\"marker cross flowchart-v2\" viewBox=\"0 0 11 11\" refX=\"-1\" refY=\"5.2\" markerUnits=\"userSpaceOnUse\" markerWidth=\"11\" markerHeight=\"11\" orient=\"auto\"><path d=\"M 1,1 l 9,9 M 10,1 l -9,9\" class=\"arrowMarkerPath\" style=\"stroke-width: 2; stroke-dasharray: 1, 0;\"></path></marker><g class=\"root\"><g class=\"clusters\"></g><g class=\"edgePaths\"></g><g class=\"edgeLabels\"></g><g class=\"nodes\"><g class=\"root\" transform=\"translate(0, 0)\"><g class=\"clusters\"><g class=\"cluster\" id=\"反问目的\" data-look=\"classic\"><rect style=\"\" x=\"8\" y=\"8\" width=\"718\" height=\"153\"></rect><g class=\"cluster-label\" transform=\"translate(311, 8)\"><foreignObject width=\"112\" height=\"24\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: table-cell; white-space: nowrap; line-height: 1.5;\"><span class=\"nodeLabel\"><p>反问的三大目的</p></span></div></foreignObject></g></g></g><g class=\"edgePaths\"></g><g class=\"edgeLabels\"></g><g class=\"nodes\"><g class=\"node default\" id=\"flowchart-P1-0\" transform=\"translate(129, 84.5)\"><rect class=\"basic label-container\" style=\"fill:#e3f2fd !important\" x=\"-86\" y=\"-39\" width=\"172\" height=\"78\"></rect><g class=\"label\" style=\"\" transform=\"translate(-56, -24)\"><rect></rect><foreignObject width=\"112\" height=\"48\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;\"><span class=\"nodeLabel\"><p>🎯 收集信息<br>了解团队和公司</p></span></div></foreignObject></g></g><g class=\"node default\" id=\"flowchart-P2-1\" transform=\"translate(359, 84.5)\"><rect class=\"basic label-container\" style=\"fill:#e8f5e9 !important\" x=\"-94\" y=\"-39\" width=\"188\" height=\"78\"></rect><g class=\"label\" style=\"\" transform=\"translate(-64, -24)\"><rect></rect><foreignObject width=\"128\" height=\"48\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;\"><span class=\"nodeLabel\"><p>💡 展示思考<br>体现专业性和深度</p></span></div></foreignObject></g></g><g class=\"node default\" id=\"flowchart-P3-2\" transform=\"translate(597, 84.5)\"><rect class=\"basic label-container\" style=\"fill:#fff3e0 !important\" x=\"-94\" y=\"-39\" width=\"188\" height=\"78\"></rect><g class=\"label\" style=\"\" transform=\"translate(-64, -24)\"><rect></rect><foreignObject width=\"128\" height=\"48\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;\"><span class=\"nodeLabel\"><p>🤝 建立连接<br>与面试官产生共鸣</p></span></div></foreignObject></g></g></g></g></g></g></g></svg></div>\n<hr>\n<h2 data-heading=\"二、必问问题（推荐每个面试都问）\" dir=\"auto\">二、必问问题（推荐每个面试都问）</h2>\n<h3 data-heading=\"关于岗位\" dir=\"auto\">关于岗位</h3>\n<ol>\n<li dir=\"auto\">\n<p><strong>\"这个岗位的核心职责是什么？短期和长期的目标分别是什么？\"</strong></p>\n<ul>\n<li dir=\"auto\">了解岗位的真实需求，判断是否匹配</li>\n</ul>\n</li>\n<li dir=\"auto\">\n<p><strong>\"团队目前面临的最大技术挑战是什么？\"</strong></p>\n<ul>\n<li dir=\"auto\">展示你对技术问题的关注</li>\n</ul>\n</li>\n<li dir=\"auto\">\n<p><strong>\"这个岗位的典型工作日是怎样的？\"</strong></p>\n<ul>\n<li dir=\"auto\">了解实际工作内容</li>\n</ul>\n</li>\n</ol>\n<h3 data-heading=\"关于团队\" dir=\"auto\">关于团队</h3>\n<ol start=\"4\">\n<li dir=\"auto\">\n<p><strong>\"团队的技术栈和架构是怎样的？\"</strong></p>\n<ul>\n<li dir=\"auto\">了解技术环境</li>\n</ul>\n</li>\n<li dir=\"auto\">\n<p><strong>\"团队规模多大？分工如何？\"</strong></p>\n<ul>\n<li dir=\"auto\">了解团队协作模式</li>\n</ul>\n</li>\n<li dir=\"auto\">\n<p><strong>\"团队的学习和成长氛围如何？\"</strong></p>\n<ul>\n<li dir=\"auto\">了解成长空间</li>\n</ul>\n</li>\n</ol>\n<h3 data-heading=\"关于技术\" dir=\"auto\">关于技术</h3>\n<ol start=\"7\">\n<li dir=\"auto\">\n<p><strong>\"贵公司在 Agent 技术方面目前有哪些应用？未来规划是什么？\"</strong></p>\n<ul>\n<li dir=\"auto\">展示对 Agent 领域的关注</li>\n</ul>\n</li>\n<li dir=\"auto\">\n<p><strong>\"团队对大模型技术的选型策略是怎样的？\"</strong></p>\n<ul>\n<li dir=\"auto\">了解技术决策过程</li>\n</ul>\n</li>\n</ol>\n<h3 data-heading=\"关于流程\" dir=\"auto\">关于流程</h3>\n<ol start=\"9\">\n<li dir=\"auto\">\n<p><strong>\"面试流程还有几轮？大概多久有结果？\"</strong></p>\n<ul>\n<li dir=\"auto\">了解后续安排</li>\n</ul>\n</li>\n<li dir=\"auto\">\n<p><strong>\"您对我今天的表现有什么建议？\"</strong></p>\n<ul>\n<li dir=\"auto\">展示谦虚和学习态度</li>\n</ul>\n</li>\n</ol>\n<hr>\n<h2 data-heading=\"三、按面试官角色分类\" dir=\"auto\">三、按面试官角色分类</h2>\n<h3 data-heading=\"技术面试官\" dir=\"auto\">技术面试官</h3>\n<pre style=\"overflow-x: hidden !important; padding: 6px 12px 8px !important;\"><code style=\"display: block !important; width: 100% !important; min-width: 0px !important; overflow-x: auto !important; white-space: pre !important; overflow-wrap: normal !important; max-width: 100% !important; box-sizing: border-box !important; padding: 4px 0px 2px !important;\">1. \"您负责的系统目前最大的技术挑战是什么？\"\n2. \"团队在 Agent 技术选型上有什么考虑？\"\n3. \"代码质量和工程规范方面有什么要求？\"\n4. \"技术分享和学习氛围如何？\"\n5. \"上线流程和发布频率是怎样的？\"\n</code><button class=\"copy-code-button\" aria-label=\"复制代码\" title=\"复制代码\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"svg-icon lucide-copy\"><rect x=\"8\" y=\"8\" width=\"14\" height=\"14\" rx=\"2\" ry=\"2\"></rect><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"></path></svg></button></pre>\n<h3 data-heading=\"HR 面试官\" dir=\"auto\">HR 面试官</h3>\n<pre style=\"overflow-x: hidden !important; padding: 6px 12px 8px !important;\"><code style=\"display: block !important; width: 100% !important; min-width: 0px !important; overflow-x: auto !important; white-space: pre !important; overflow-wrap: normal !important; max-width: 100% !important; box-sizing: border-box !important; padding: 4px 0px 2px !important;\">1. \"公司的培养体系和晋升通道是怎样的？\"\n2. \"团队的氛围和文化是怎样的？\"\n3. \"薪资结构和福利体系是怎样的？\"\n4. \"工作时间安排和弹性工作制度？\"\n5. \"入职后的培训和融入计划？\"\n</code><button class=\"copy-code-button\" aria-label=\"复制代码\" title=\"复制代码\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"svg-icon lucide-copy\"><rect x=\"8\" y=\"8\" width=\"14\" height=\"14\" rx=\"2\" ry=\"2\"></rect><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"></path></svg></button></pre>\n<h3 data-heading=\"部门负责人\" dir=\"auto\">部门负责人</h3>\n<pre style=\"overflow-x: hidden !important; padding: 6px 12px 8px !important;\"><code style=\"display: block !important; width: 100% !important; min-width: 0px !important; overflow-x: auto !important; white-space: pre !important; overflow-wrap: normal !important; max-width: 100% !important; box-sizing: border-box !important; padding: 4px 0px 2px !important;\">1. \"部门今年的重点目标是什么？\"\n2. \"Agent 技术在业务中的应用现状和规划？\"\n3. \"团队接下来的人员规划是怎样的？\"\n4. \"对这个岗位的期望和成长路径？\"\n5. \"部门的技术氛围和创新空间？\"\n</code><button class=\"copy-code-button\" aria-label=\"复制代码\" title=\"复制代码\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"svg-icon lucide-copy\"><rect x=\"8\" y=\"8\" width=\"14\" height=\"14\" rx=\"2\" ry=\"2\"></rect><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"></path></svg></button></pre>\n<hr>\n<h2 data-heading=\"四、问题红黑榜\" dir=\"auto\">四、问题红黑榜</h2>\n<h3 data-heading=\"✅ 红榜（推荐问）\" dir=\"auto\">✅ 红榜（推荐问）</h3>\n<table>\n<thead>\n<tr>\n<th>问题</th>\n<th>为什么好</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>团队的技术挑战</td>\n<td>展示技术热情</td>\n</tr>\n<tr>\n<td>岗位的成长空间</td>\n<td>展示职业规划</td>\n</tr>\n<tr>\n<td>技术选型考虑</td>\n<td>展示技术深度</td>\n</tr>\n<tr>\n<td>团队氛围</td>\n<td>展示团队意识</td>\n</tr>\n<tr>\n<td>反馈建议</td>\n<td>展示学习态度</td>\n</tr>\n</tbody>\n</table>\n<h3 data-heading=\"❌ 黑榜（避免问）\" dir=\"auto\">❌ 黑榜（避免问）</h3>\n<table>\n<thead>\n<tr>\n<th>问题</th>\n<th>为什么不好</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>\"我面试通过了吗？\"</td>\n<td>过于直接，不合适</td>\n</tr>\n<tr>\n<td>\"加班多吗？\"</td>\n<td>给人不愿付出的印象</td>\n</tr>\n<tr>\n<td>\"薪资能给多少？\"</td>\n<td>不应在首轮就问</td>\n</tr>\n<tr>\n<td>\"公司做什么的？\"</td>\n<td>显得没做功课</td>\n</tr>\n<tr>\n<td>\"我能拿多少股票？\"</td>\n<td>过于功利</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 data-heading=\"五、反问的时机和方式\" dir=\"auto\">五、反问的时机和方式</h2>\n<h3 data-heading=\"时机\" dir=\"auto\">时机</h3>\n<ul>\n<li dir=\"auto\">一般在面试最后，面试官说\"你有什么问题要问我吗？\"时</li>\n<li dir=\"auto\">如果是多轮面试，每轮结束时都可以反问</li>\n<li dir=\"auto\">不要在面试中间频繁打断反问</li>\n</ul>\n<h3 data-heading=\"方式\" dir=\"auto\">方式</h3>\n<ul>\n<li dir=\"auto\">准备 2-3 个问题，根据面试时间灵活调整</li>\n<li dir=\"auto\">问题要具体，不要太空泛</li>\n<li dir=\"auto\">可以基于面试中聊到的内容延伸提问</li>\n<li dir=\"auto\">认真听面试官的回答，适当互动</li>\n</ul>\n<hr>\n<h2 data-heading=\"六、相关知识点\" dir=\"auto\">六、相关知识点</h2>\n<ul>\n<li dir=\"auto\"><a data-href=\"%E5%A4%A7%E6%A8%A1%E5%9E%8B/%E5%A4%A7%E6%A8%A1%E5%9E%8B%E9%9D%A2%E8%AF%95/%E9%A2%98%E9%9B%86/03-%E9%9D%A2%E8%AF%95%E6%94%BB%E7%95%A5/%E8%87%AA%E6%88%91%E4%BB%8B%E7%BB%8D%E6%A8%A1%E6%9D%BF/\" href=\"/%E5%A4%A7%E6%A8%A1%E5%9E%8B/%E5%A4%A7%E6%A8%A1%E5%9E%8B%E9%9D%A2%E8%AF%95/%E9%A2%98%E9%9B%86/03-%E9%9D%A2%E8%AF%95%E6%94%BB%E7%95%A5/%E8%87%AA%E6%88%91%E4%BB%8B%E7%BB%8D%E6%A8%A1%E6%9D%BF/\" class=\"internal-link\" target=\"\" rel=\"noopener nofollow\">自我介绍模板</a> — 自我介绍准备</li>\n<li dir=\"auto\"><a data-href=\"%E5%A4%A7%E6%A8%A1%E5%9E%8B/%E5%A4%A7%E6%A8%A1%E5%9E%8B%E9%9D%A2%E8%AF%95/%E9%A2%98%E9%9B%86/03-%E9%9D%A2%E8%AF%95%E6%94%BB%E7%95%A5/%E8%96%AA%E8%B5%84%E8%B0%88%E5%88%A4%E6%8A%80%E5%B7%A7/\" href=\"/%E5%A4%A7%E6%A8%A1%E5%9E%8B/%E5%A4%A7%E6%A8%A1%E5%9E%8B%E9%9D%A2%E8%AF%95/%E9%A2%98%E9%9B%86/03-%E9%9D%A2%E8%AF%95%E6%94%BB%E7%95%A5/%E8%96%AA%E8%B5%84%E8%B0%88%E5%88%A4%E6%8A%80%E5%B7%A7/\" class=\"internal-link\" target=\"\" rel=\"noopener nofollow\">薪资谈判技巧</a> — 薪资相关话题</li>\n</ul>","headings":[]}