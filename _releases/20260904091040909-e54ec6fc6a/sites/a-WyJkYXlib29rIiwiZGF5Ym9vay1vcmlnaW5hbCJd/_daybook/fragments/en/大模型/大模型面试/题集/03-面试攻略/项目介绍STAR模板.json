ll:rgba(232,232,232, 0.8);}#m42f3d24562496d21 .label-icon{display:inline-block;height:1em;overflow:visible;vertical-align:-0.125em;}#m42f3d24562496d21 .node .label-icon path{fill:currentColor;stroke:revert;stroke-width:revert;}#m42f3d24562496d21 :root{--mermaid-font-family:\"trebuchet ms\",verdana,arial,sans-serif;}</style><g><marker id=\"m42f3d24562496d21-m42f3d24562496d21_flowchart-v2-pointEnd\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refX=\"5\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto\"><path d=\"M 0 0 L 10 5 L 0 10 z\" class=\"arrowMarkerPath\" style=\"stroke-width: 1; stroke-dasharray: 1, 0;\"></path></marker><marker id=\"m42f3d24562496d21-m42f3d24562496d21_flowchart-v2-pointStart\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refX=\"4.5\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto\"><path d=\"M 0 5 L 10 10 L 10 0 z\" class=\"arrowMarkerPath\" style=\"stroke-width: 1; stroke-dasharray: 1, 0;\"></path></marker><marker id=\"m42f3d24562496d21-m42f3d24562496d21_flowchart-v2-circleEnd\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refX=\"11\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"11\" markerHeight=\"11\" orient=\"auto\"><circle cx=\"5\" cy=\"5\" r=\"5\" class=\"arrowMarkerPath\" style=\"stroke-width: 1; stroke-dasharray: 1, 0;\"></circle></marker><marker id=\"m42f3d24562496d21-m42f3d24562496d21_flowchart-v2-circleStart\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refX=\"-1\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"11\" markerHeight=\"11\" orient=\"auto\"><circle cx=\"5\" cy=\"5\" r=\"5\" class=\"arrowMarkerPath\" style=\"stroke-width: 1; stroke-dasharray: 1, 0;\"></circle></marker><marker id=\"m42f3d24562496d21-m42f3d24562496d21_flowchart-v2-crossEnd\" class=\"marker cross flowchart-v2\" viewBox=\"0 0 11 11\" refX=\"12\" refY=\"5.2\" markerUnits=\"userSpaceOnUse\" markerWidth=\"11\" markerHeight=\"11\" orient=\"auto\"><path d=\"M 1,1 l 9,9 M 10,1 l -9,9\" class=\"arrowMarkerPath\" style=\"stroke-width: 2; stroke-dasharray: 1, 0;\"></path></marker><marker id=\"m42f3d24562496d21-m42f3d24562496d21_flowchart-v2-crossStart\" class=\"marker cross flowchart-v2\" viewBox=\"0 0 11 11\" refX=\"-1\" refY=\"5.2\" markerUnits=\"userSpaceOnUse\" markerWidth=\"11\" markerHeight=\"11\" orient=\"auto\"><path d=\"M 1,1 l 9,9 M 10,1 l -9,9\" class=\"arrowMarkerPath\" style=\"stroke-width: 2; stroke-dasharray: 1, 0;\"></path></marker><g class=\"root\"><g class=\"clusters\"></g><g class=\"edgePaths\"></g><g class=\"edgeLabels\"></g><g class=\"nodes\"><g class=\"root\" transform=\"translate(0, 0)\"><g class=\"clusters\"><g class=\"cluster\" id=\"重点突出\" data-look=\"classic\"><rect style=\"\" x=\"8\" y=\"8\" width=\"860.0703125\" height=\"153\"></rect><g class=\"cluster-label\" transform=\"translate(373.546875, 8)\"><foreignObject width=\"128.9765625\" height=\"24\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: table-cell; white-space: nowrap; line-height: 1.5;\"><span class=\"nodeLabel\"><p>Action 部分的结构</p></span></div></foreignObject></g></g></g><g class=\"edgePaths\"></g><g class=\"edgeLabels\"></g><g class=\"nodes\"><g class=\"node default\" id=\"flowchart-A1-0\" transform=\"translate(137.03515625, 84.5)\"><rect class=\"basic label-container\" style=\"fill:#e3f2fd !important\" x=\"-94.03515625\" y=\"-39\" width=\"188.0703125\" height=\"78\"></rect><g class=\"label\" style=\"\" transform=\"translate(-64.03515625, -24)\"><rect></rect><foreignObject width=\"128.0703125\" height=\"48\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;\"><span class=\"nodeLabel\"><p>技术选型理由<br>为什么选 A 不选 B</p></span></div></foreignObject></g></g><g class=\"node default\" id=\"flowchart-A2-1\" transform=\"translate(367.0703125, 84.5)\"><rect class=\"basic label-container\" style=\"fill:#e8f5e9 !important\" x=\"-86\" y=\"-39\" width=\"172\" height=\"78\"></rect><g class=\"label\" style=\"\" transform=\"translate(-56, -24)\"><rect></rect><foreignObject width=\"112\" height=\"48\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;\"><span class=\"nodeLabel\"><p>遇到的挑战<br>具体是什么问题</p></span></div></foreignObject></g></g><g class=\"node default\" id=\"flowchart-A3-2\" transform=\"translate(573.0703125, 84.5)\"><rect class=\"basic label-container\" style=\"fill:#fff3e0 !important\" x=\"-70\" y=\"-39\" width=\"140\" height=\"78\"></rect><g class=\"label\" style=\"\" transform=\"translate(-40, -24)\"><rect></rect><foreignObject width=\"80\" height=\"48\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;\"><span class=\"nodeLabel\"><p>解决方案<br>如何解决的</p></span></div></foreignObject></g></g><g class=\"node default\" id=\"flowchart-A4-3\" transform=\"translate(763.0703125, 84.5)\"><rect class=\"basic label-container\" style=\"fill:#f3e5f5 !important\" x=\"-70\" y=\"-39\" width=\"140\" height=\"78\"></rect><g class=\"label\" style=\"\" transform=\"translate(-40, -24)\"><rect></rect><foreignObject width=\"80\" height=\"48\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;\"><span class=\"nodeLabel\"><p>你的贡献<br>不是团队的</p></span></div></foreignObject></g></g></g></g></g></g></g></svg></div>\n<h3 data-heading=\"4.3. 常见问题准备\" dir=\"auto\">4.3. 常见问题准备</h3>\n<p dir=\"auto\">针对每个项目，提前准备以下问题的回答：</p>\n<ol>\n<li dir=\"auto\"><strong>技术选型</strong>：为什么选择这个技术栈？</li>\n<li dir=\"auto\"><strong>挑战应对</strong>：遇到的最大困难是什么？怎么解决的？</li>\n<li dir=\"auto\"><strong>如果重做</strong>：如果重新做，你会怎么改进？</li>\n<li dir=\"auto\"><strong>量化成果</strong>：具体的数据指标是什么？</li>\n<li dir=\"auto\"><strong>团队协作</strong>：你在团队中扮演什么角色？</li>\n</ol>\n<hr>\n<h2 data-heading=\"5. 五、相关知识点\" dir=\"auto\">5. 五、相关知识点</h2>\n<ul>\n<li dir=\"auto\"><a data-href=\"%E5%A4%A7%E6%A8%A1%E5%9E%8B/%E5%A4%A7%E6%A8%A1%E5%9E%8B%E9%9D%A2%E8%AF%95/%E9%A2%98%E9%9B%86/03-%E9%9D%A2%E8%AF%95%E6%94%BB%E7%95%A5/%E8%87%AA%E6%88%91%E4%BB%8B%E7%BB%8D%E6%A8%A1%E6%9D%BF/\" href=\"/%E5%A4%A7%E6%A8%A1%E5%9E%8B/%E5%A4%A7%E6%A8%A1%E5%9E%8B%E9%9D%A2%E8%AF%95/%E9%A2%98%E9%9B%86/03-%E9%9D%A2%E8%AF%95%E6%94%BB%E7%95%A5/%E8%87%AA%E6%88%91%E4%BB%8B%E7%BB%8D%E6%A8%A1%E6%9D%BF/\" class=\"internal-link\" target=\"\" rel=\"noopener nofollow\">自我介绍模板</a> — 自我介绍的准备</li>\n<li dir=\"auto\"><a data-href=\"%E5%A4%A7%E6%A8%A1%E5%9E%8B/%E5%A4%A7%E6%A8%A1%E5%9E%8B%E9%9D%A2%E8%AF%95/%E9%A2%98%E9%9B%86/03-%E9%9D%A2%E8%AF%95%E6%94%BB%E7%95%A5/%E7%B3%BB%E7%BB%9F%E8%AE%BE%E8%AE%A1%E9%A2%98%E6%94%BB%E7%95%A5/\" href=\"/%E5%A4%A7%E6%A8%A1%E5%9E%8B/%E5%A4%A7%E6%A8%A1%E5%9E%8B%E9%9D%A2%E8%AF%95/%E9%A2%98%E9%9B%86/03-%E9%9D%A2%E8%AF%95%E6%94%BB%E7%95%A5/%E7%B3%BB%E7%BB%9F%E8%AE%BE%E8%AE%A1%E9%A2%98%E6%94%BB%E7%95%A5/\" class=\"internal-link\" target=\"\" rel=\"noopener nofollow\">系统设计题攻略</a> — 如何回答系统设计题</li>\n</ul>","headings":[]}